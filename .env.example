# ==============================================================================
# APEX FORMULA 2026 — UKÁZKOVÝ SOUBOR PROSTŘEDÍ (.env.example)
# Všechny skutečné API klíče a tajné hodnoty jsou v bezpečí a ignorovány v .gitignore.
# ==============================================================================

# Volitelné: Google Gemini API klíč pro AI asistenci / hlas
GEMINI_API_KEY="AIzaSy_VASE_VOLITELNA_HODNOTA"

# URL aplikace (automaticky přiřazuje Vercel / Cloud Run)
APP_URL="https://vase-domena.vercel.app"

# ==============================================================================
# FIREBASE & VERCEL / GITHUB DEPLOYMENT (BEZPEČNÉ ŠABLONY BEZ SKUTEČNÝCH TAJEMSTVÍ)
# ==============================================================================
# Pro produkční nasazení s vlastním Firebase projektem vložte do .env.local:
VITE_FIREBASE_PROJECT_ID="vase-id-projektu"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_API_KEY="AIzaSy_ZDE_VLOZTE_SVUJ_API_KLIC"
VITE_FIREBASE_AUTH_DOMAIN="vase-id-projektu.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="vase-firestore-databaze-id"
VITE_FIREBASE_STORAGE_BUCKET="vase-id-projektu.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
