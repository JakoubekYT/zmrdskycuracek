rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Collection 1: Career Hall of Fame Standings (Public Leaderboard)
    match /hall_of_fame_drivers/{userId} {
      allow get, list: if true;

      allow create, update: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        incoming().userId == request.auth.uid &&
        incoming().displayName is string &&
        incoming().displayName.size() >= 1 &&
        incoming().displayName.size() <= 60 &&
        incoming().wins is number &&
        incoming().wins >= 0 &&
        incoming().racesCompleted is number &&
        incoming().racesCompleted >= 0 &&
        incoming().podiums is number &&
        incoming().podiums >= 0;

      allow delete: if false;
    }

    // Collection 2: Circuit Fastest Lap Hall of Fame Records (Public Leaderboard)
    match /hall_of_fame_laps/{recordId} {
      allow get, list: if true;

      allow create, update: if isSignedIn() &&
        isValidId(recordId) &&
        incoming().userId == request.auth.uid &&
        incoming().displayName is string &&
        incoming().displayName.size() >= 1 &&
        incoming().displayName.size() <= 60 &&
        incoming().trackId is string &&
        incoming().trackId.size() >= 1 &&
        incoming().trackId.size() <= 60 &&
        incoming().lapTimeMs is number &&
        incoming().lapTimeMs >= 3000 &&
        incoming().lapTimeMs <= 900000;

      allow delete: if false;
    }

    // Collection 3: Real-Time Cross-Device Multiplayer Lobbies
    match /multiplayer_lobbies/{roomId} {
      allow get, list: if true;
      allow create, update: if isValidId(roomId);
      allow delete: if isSignedIn();
    }

    // Collection 4: Connection health probe
    match /test/{docId} {
      allow get: if true;
    }
  }
}
